{
  "manifest_version": 3,
  "name": "SoundMax - Tab Audio Booster & EQ",
  "short_name": "SoundMax",
  "version": "1.2.0",
  "description": "Tingkatkan volume tab hingga 600%, sesuaikan Equalizer Studio 5-Band (60Hz - 12kHz), simpan preset custom, dan beralih ke tab bersuara dengan sekali klik.",
  "author": "Pikuri (https://github.com/Pikurii)",
  "homepage_url": "https://github.com/Pikurii",
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SoundMax",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+V"
      },
      "description": "Buka popup SoundMax"
    },
    "volume_up": {
      "suggested_key": {
        "default": "Alt+Up"
      },
      "description": "Tingkatkan volume +10%"
    },
    "volume_down": {
      "suggested_key": {
        "default": "Alt+Down"
      },
      "description": "Kurangi volume -10%"
    },
    "toggle_mute": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Mute / Unmute tab saat ini"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
